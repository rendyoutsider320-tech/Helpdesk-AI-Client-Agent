[Unit]
Description=Helpdesk AI Client Agent Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/helpdesk-agent
ExecStart=/opt/helpdesk-agent/agent-client
Restart=always
RestartSec=5s
KillMode=process
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
